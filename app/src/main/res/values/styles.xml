<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Este estilo é aplicado aos TextViews na Tela de Detalhes
        para garantir que eles ocupem a largura total e tenham um bom espaçamento.
    -->
    <style name="DetalheTextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#263238</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- Se você estiver usando um tema herdado de Theme.AppCompat,
         pode ser necessário adicionar o estilo AppTheme principal aqui.
         Exemplo:
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
         <item name="colorPrimary">@color/colorPrimary</item>
         <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
         <item name="colorAccent">@color/colorAccent</item>
    </style>
    -->
</resources>
