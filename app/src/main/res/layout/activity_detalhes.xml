<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detalhes_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/darker_gray"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".DetalhesActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/gradient_botao_voltar"
            android:padding="10dp"
            android:text="@string/titulo_detalhes" android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_detalhes_cidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="50dp"
            android:background="@drawable/gradient_background_gray"
            android:padding="@dimen/cardview_default_radius"
            android:text="@string/carregando" tools:text="São Paulo, BR - 19°C (Nublado)" android:textColor="#030404"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background_gray"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_sensacao"
            style="@style/DetalheTextView"
            tools:text="Sensação Térmica: --°C" android:text="@string/mock_sensacao" /> <TextView
        android:id="@+id/tv_umidade"
        style="@style/DetalheTextView"
        android:text="@string/mock_umidade" /> <TextView
        android:id="@+id/tv_pressao"
        style="@style/DetalheTextView"
        android:text="@string/mock_pressao" /> <TextView
        android:id="@+id/tv_temp_min_max"
        style="@style/DetalheTextView"
        tools:text="Mínima/Máxima: --°C / --°C" android:text="@string/mock_min_max" /> </LinearLayout>

    <Button
        android:id="@+id/btnVoltarDet"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="340dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#CCC8C4"
        android:padding="14dp"
        android:text="@string/btn_voltar_menu" android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>