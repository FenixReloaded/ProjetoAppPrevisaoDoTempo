<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/cidade_main_layout"
    android:background="@android:color/darker_gray"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".SelecaoCidadeActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:background="@drawable/gradient_botao_voltar"
        android:padding="5dp"
        android:text="Definir Localidade"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/gradient_background_gray"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Buscar Cidade"
            android:textAlignment="center"
            android:layout_marginTop="15dp"
            android:background="@drawable/gradient_botao_voltar"
            android:textColor="@color/white"
            android:textSize="18sp" />

    <EditText
        android:id="@+id/et_busca_cidade"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="15dp"
        android:background="@drawable/gradient_background_gray"
        android:hint="Digite o nome da cidade..."
        android:imeOptions="actionSearch"
        android:textColor="@color/white"
        android:inputType="textCapWords"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_buscar"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#CAC6C2"
        android:padding="14dp"
        android:text="Buscar"
        android:textColor="#000000" />

    <TextView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/gradient_botao_voltar"
        android:text="Cidades Sugeridas"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_background_gray"
        android:lineSpacingExtra="8dp"
        android:padding="12dp"
        android:text="1.São Paulo, BR\n2. Rio de Janeiro, BR\n3. Porto Alegre, BR\n4. Londres, GB"
        android:textColor="#020202"
        android:textSize="16sp" />

    </LinearLayout>

    <Button
        android:id="@+id/btnVoltarPer"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="250dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#CCC8C4"
        android:padding="14dp"
        android:text="Voltar ao Menu Principal"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>