<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/cidade_main_layout"
    android:background="@android:color/darker_gray"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".SelecaoCidadeActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Buscar Nova Cidade"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_busca_cidade"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/fundo_edittext"
        android:hint="Digite o nome da cidade..."
        android:imeOptions="actionSearch"
        android:inputType="textCapWords"
        android:padding="16dp" />

    <Button
        android:id="@+id/btn_buscar"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#CAC6C2"
        android:padding="14dp"
        android:text="Buscar"
        android:textColor="#000000" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Cidades Sugeridas"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@android:color/background_light"
        android:lineSpacingExtra="8dp"
        android:padding="12dp"
        android:text="1. Rio de Janeiro, BR\n2. Porto Alegre, BR\n3. Londres, GB"
        android:textColor="#020202"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnVoltarPer"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:layout_marginBottom="40dp"
        android:backgroundTint="#CCC8C4"
        android:padding="14dp"
        android:text="Voltar ao Menu Principal"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>