<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/forecast_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@android:color/darker_gray"
    android:padding="24dp"
    tools:context=".ForecastActivity">

    <TextView
        android:id="@+id/tv_forecast_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/gradient_botao_voltar"
        android:padding="10dp"
        tools:text="Previsão Semanal"
        android:text="@string/titulo_previsao_semanal"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_forecast"
        android:layout_width="match_parent"
        android:nestedScrollingEnabled="true"
        android:textAlignment="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="50dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/forecast_item_layout" />

    <Button
        android:id="@+id/btn_voltar_forecast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="30dp"
        android:layout_marginHorizontal="50dp"
        android:backgroundTint="#CCC8C4"
        android:padding="14dp"
        android:text="@string/btn_voltar_menu"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>